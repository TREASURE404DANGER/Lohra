# ==============================================================================
# Wabot Configuration (.env)
# ==============================================================================

# ----------------- WhatsApp Pairing & Identity -----------------
# Your WhatsApp phone number with country code (e.g. 2348012345678 or +2349012345678).
# LEAVE BLANK by default to be prompted interactively in the terminal on first boot:
PHONE_NUMBER=

# Default international country code used when phone numbers start with '0' (e.g. 234 for Nigeria):
DEFAULT_CC=234

# Prefix for text commands in WhatsApp (e.g. Lohra status, Lohra command ...):
PREFIX=Lohra

# Comma-separated list of additional phone numbers allowed to issue admin/owner commands:
ALLOWED=

# Whether public users in other chats can use non-admin commands like 'ping' (true/false):
PUBLIC=false

# ----------------- Google Gemini AI -----------------
# Required for Voice transcription, Voice commands, and Natural language instructions:
GEMINI_API_KEY=

# Audio pacing multiplier for Gemini Live STT streaming (default: 2):
GEMINI_STT_SPEEDUP=2

# Primary language code for speech recognition (default: en-US):
GEMINI_STT_LANG=en-US

# ----------------- Storage & System Paths -----------------
# Working directory for auth credentials, contacts, and action states:
DATA_DIR=./data

# Plugins folder:
PLUGINS_DIR=./plugins

# Optional custom FFmpeg binary path (automatically configured by start.js if using ffmpeg-static):
# FFMPEG_PATH=

# Logging level (info, warn, error, debug):
LOG_LEVEL=info
LOG_PRETTY=true
