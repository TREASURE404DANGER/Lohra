def gemini_decls():
    out = []
    for name, t in TOOLS.items():
        params = {"type": "object", "properties": {k: ({"type": ty, "description": d, **({"items": {"type": "string"}} if ty == "array" else {})}) for k, (ty, d) in t["props"].items()}}
        if t["req"]:
            params["required"] = t["req"]
        decl = {"name": name, "description": t["desc"]}
        if t["props"]:
            decl["parameters"] = params
        out.append(decl)
    return out


def call_tool(name, args):
    t = TOOLS.get(name)
    if not t:
        return {"ok": False, "error": "unknown_tool", "message": f"Unknown tool '{name}'. Available: {', '.join(TOOLS)}"}, 2
    if not isinstance(args, dict):
        return {"ok": False, "error": "bad_args", "message": "Arguments must be a JSON object."}, 2
    extra = set(args) - set(t["props"])
    if extra:
        return {"ok": False, "error": "bad_args", "message": f"Unexpected argument(s): {', '.join(sorted(extra))}"}, 2
    for k in t["req"]:
        if not isinstance(args.get(k), str) or not args[k].strip():
            return {"ok": False, "error": "bad_args", "message": f"'{k}' is required (non-empty string)."}, 2
    try:
        res = t["run"](args)
    except Unreachable as e:
        return {"ok": False, "error": "bot_unreachable", "message": str(e), "retryable": True}, 3
    return res, code_for(res)


def wait_for(action_id, timeout):
    end = time.time() + timeout
    while True:
        res = rpc("get", id=action_id)
        if not res.get("ok") or res.get("status") not in OPEN:
            return res
        if time.time() >= end:
            res["waiting"] = True
            res["message"] = "Still waiting for the owner to answer on WhatsApp."
            return res
        time.sleep(1.5)


# ---------------------------------------------------------------- contacts (admin, local file)
def norm_number(s, cc=""):
    d = "".join(ch for ch in str(s) if ch.isdigit())
    if d.startswith("00"):
        d = d[2:]
    elif d.startswith("0"):
        if not cc:
            return None, "needs a country code (or pass --cc 234)"
        d = "".join(ch for ch in cc if ch.isdigit()) + d[1:]
    if not 8 <= len(d) <= 15:
        return None, "not a valid phone number (8-15 digits with country code)"
    return d, None

def read_contacts():
    if not CONTACTS.exists():
        return {}
    data = json.loads(CONTACTS.read_text() or "{}")
    return data

def write_contacts(data):
    CONTACTS.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONTACTS.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    os.replace(tmp, CONTACTS)

def entries(data):
    """-> list of (name, number_or_jid, aliases, note)"""
    src = data.get("contacts") if isinstance(data, dict) and isinstance(data.get("contacts"), (dict, list)) else data
    items = [(v.get("name"), v) for v in src if isinstance(v, dict)] if isinstance(src, list) else list(src.items()) if isinstance(src, dict) else []
    out = []
    for name, v in items:
        if not name or str(name).startswith("_"):
            continue
        if isinstance(v, (str, int)):
            out.append((name, str(v), [], ""))
        elif isinstance(v, dict):
            al = v.get("aliases", [])
            al = [a.strip() for a in al.split(",")] if isinstance(al, str) else list(al)
            out.append((name, str(v.get("jid") or v.get("number") or v.get("phone") or ""), al, v.get("note", "")))
    return out


def contacts_cmd(a):
    if a.sub in ("list",) and not AGENT_ROLE:
        rows = [{"name": n, "number": num, "aliases": al, "note": note} for n, num, al, note in entries(read_contacts())]
        return {"ok": True, "count": len(rows), "contacts": rows, "file": str(CONTACTS)}, 0
    if a.sub == "list":
        return rpc("contacts.list"), 0
    if a.sub == "find":
        r = rpc("contacts.find", query=a.name)
        return r, code_for(r)
    if AGENT_ROLE:
        return {"ok": False, "error": "forbidden", "message": "Editing contacts is not available to agents."}, 4
    if a.sub == "path":
        return {"ok": True, "file": str(CONTACTS), "exists": CONTACTS.exists()}, 0
    if a.sub == "check":
        try:
            data = read_contacts()
        except json.JSONDecodeError as e:
            return {"ok": False, "error": "invalid_json", "message": str(e)}, 4
        problems, seen = [], {}
        for n, num, al, _ in entries(data):
            if "@" not in num:
                d, e = norm_number(num, a.cc or "")
                if e:
                    problems.append(f"{n}: {e}")
            for key in [n.lower()] + [x.lower() for x in al]:
                if key in seen and seen[key] != n:
                    problems.append(f'"{key}" is used by both {seen[key]} and {n}')
                seen[key] = n
        return {"ok": not problems, "count": len(entries(data)), "problems": problems}, 0 if not problems else 4
    data = read_contacts()
    if a.sub == "add":
        if isinstance(data, list):
            return {"ok": False, "error": "unsupported", "message": "contacts.json is a list; convert it to an object first."}, 4
        if "@" in a.number:
            val = {"jid": a.number}
        else:
            d, e = norm_number(a.number, a.cc or "")
            if e:
                return {"ok": False, "error": "invalid_number", "message": f"{a.number}: {e}"}, 4
            val = {"number": "+" + d}
        clash = [n for n, _ in data.items() if n.lower() == a.name.lower()]
        if clash and not a.update:
            return {"ok": False, "error": "exists", "message": f"'{clash[0]}' already exists. Use --update to change it."}, 4
        for c in clash:
            data.pop(c)
        if a.alias:
            val["aliases"] = a.alias
        if a.note:
            val["note"] = a.note
        data[a.name] = val if (a.alias or a.note or "jid" in val) else val["number"]
        write_contacts(data)
        return {"ok": True, "saved": a.name, "file": str(CONTACTS)}, 0
    if a.sub == "remove":
        hit = [n for n in data if n.lower() == a.name.lower()]
        if not hit:
            return {"ok": False, "error": "not_found", "message": f"No contact named '{a.name}'."}, 4
        data.pop(hit[0])
        write_contacts(data)
        return {"ok": True, "removed": hit[0]}, 0
    return {"ok": False, "error": "usage"}, 2


# ---------------------------------------------------------------- output
def render(res):
    if not res.get("ok", True):
        lines = [f"error: {res.get('error')}" + (f" - {res.get('message')}" if res.get("message") else "")]
        for c in res.get("candidates", []):
            lines.append(f"  candidate: {c.get('name')} ({c.get('hint')})")
        if res.get("suggestions"):
            lines.append("  did you mean: " + ", ".join(res["suggestions"]))
        if res.get("hint"):
            lines.append(f"  hint: {res['hint']}")
        return "\n".join(lines)
    if "contacts" in res:
        return "\n".join(f"{c['name']:<20} {c.get('number') or c.get('hint', '')}  {('(' + ', '.join(c['aliases']) + ')') if c.get('aliases') else ''}".rstrip() for c in res["contacts"]) or "(no contacts)"
    if "active" in res and "recently_ended" in res:
        rows = [f"{w['id']}  {w['contact']:<14} {w['kind']:<8} {'keep' if w['keep_watching'] else 'once':<5} {w['hours_left']}h left  {w.get('condition') or '(anything)'}" for w in res["active"]]
        return "\n".join(rows) or "(no active watches)"
    if "pending" in res and "recent" in res:
        rows = [f"{a['id']}  {a['status']:<9} {a['type']:<5} {a['to']}: {a['text'][:50]}" for a in res["pending"] + res["recent"]]
        return "\n".join(rows) or "(nothing yet)"
    out = []
    for k, v in res.items():
        if k == "ok":
            continue
        out.append(f"{k}: {json.dumps(v, ensure_ascii=False) if isinstance(v, (dict, list)) else v}")
    return "\n".join(out) or "ok"


def emit(res, code, as_json):
    print(json.dumps(res, ensure_ascii=False) if as_json else render(res))
    return code


# ---------------------------------------------------------------- main
def text_arg(a):
    if a.text_file:
        return sys.stdin.read() if a.text_file == "-" else Path(a.text_file).read_text()
    return sys.stdin.read() if a.text == "-" else a.text


def main(argv=None):
    p = argparse.ArgumentParser(prog="wabctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="force JSON output (default when piped)")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="force JSON output (default when piped)")
    sp = p.add_subparsers(dest="cmd", required=True)
    add = lambda name, **kw: sp.add_parser(name, parents=[common], **kw)

    def recipient_text(s, ttl=False):
        s.add_argument("--to", required=True, help="contact name or full phone number")
        g = s.add_mutually_exclusive_group(required=True)
        g.add_argument("--text", help="message text ('-' reads stdin)")
        g.add_argument("--text-file", help="read the text from a file ('-' = stdin)")
        if ttl:
            s.add_argument("--ttl", type=int, help="seconds the approval request stays open (30-3600)")
            s.add_argument("--wait", nargs="?", const=120, type=int, metavar="SEC", help="block until the owner answers (default 120s)")
    recipient_text(add("send", help="ask the owner to approve sending a message"), ttl=True)
    recipient_text(add("draft", help="drop a draft into the owner's own chat (no approval needed)"))
    s = add("notify", help="post a note to the owner's own chat"); s.add_argument("text")
    s = add("check", help="status of an action"); s.add_argument("id")
    s = add("wait", help="wait for the owner's answer"); s.add_argument("id"); s.add_argument("--timeout", type=int, default=120)
    s = add("cancel", help="cancel a pending request"); s.add_argument("id")
    add("pending", help="pending and recent actions")
    add("bot", help="bot connection status")
    s = add("contacts", help="list | find NAME | add NAME NUMBER | remove NAME | check | path")
    s.add_argument("sub", choices=["list", "find", "add", "remove", "check", "path"])
    s.add_argument("name", nargs="?"); s.add_argument("number", nargs="?")
    s.add_argument("--alias", action="append"); s.add_argument("--note"); s.add_argument("--cc", help="default country code for numbers starting with 0"); s.add_argument("--update", action="store_true")
    s = add("watch", help="add | list | cancel: watch a contact's NEW statuses/messages (ongoing, not a one-time check)")
    s.add_argument("sub", choices=["add", "list", "cancel"]); s.add_argument("target", nargs="?", help="cancel: watch id, contact name or 'all'")
    s.add_argument("--contact"); s.add_argument("--kind", choices=["status", "message"]); s.add_argument("--condition", help="e.g. 'is a meme'")
    s.add_argument("--keep", action="store_true", help="keep watching after the first match"); s.add_argument("--hours", type=int, help="how long to watch (default 168)")
    s = add("messages", help="find | send: look back in saved chats (voice notes, photos, texts) and forward one to the owner's own chat")
    s.add_argument("sub", choices=["find", "send"]); s.add_argument("target", nargs="?", help="send: the message id")
    s.add_argument("--contact"); s.add_argument("--kind", choices=["any", "text", "voice", "image", "video", "document", "sticker"]); s.add_argument("--from", dest="sender", choices=["any", "them", "me"])
    s.add_argument("--query"); s.add_argument("--limit", type=int); s.add_argument("--hours", type=int); s.add_argument("--send", action="store_true", help="also send the newest match to the owner's own chat")
    s = add("guide", help="operating guide for agents: which command/tool to use for which request"); 
    s = add("tools", help="tool declarations for an agent (Gemini function-calling format)"); s.add_argument("--plain", action="store_true", help="plain list instead of {functionDeclarations: [...]}")
    add("prompt", help="recommended system-prompt rules for the agent")
    s = add("call", help="run a tool the way an agent does: call TOOL '{json args}'"); s.add_argument("tool"); s.add_argument("args", nargs="?", default="{}", help="JSON object, or '-' for stdin")
    s = add("log", help="recent audit log (admin)"); s.add_argument("--tail", type=int, default=20)
    add("doctor", help="check the whole setup (admin)")

    a = p.parse_args(argv)
    as_json = getattr(a, "json", False) or not sys.stdout.isatty()
    if AGENT_ROLE and a.cmd in ("log", "doctor"):
        return emit({"ok": False, "error": "forbidden", "message": "Not available to agents."}, 4, as_json)
    if a.cmd == "contacts" and a.sub in ("find", "add", "remove") and not a.name:
        return emit({"ok": False, "error": "usage", "message": f"contacts {a.sub} needs a NAME"}, 2, as_json)
    if a.cmd == "contacts" and a.sub == "add" and not a.number:
        return emit({"ok": False, "error": "usage", "message": "contacts add NAME NUMBER"}, 2, as_json)

    try:
        if a.cmd == "guide":
            print(GUIDE)
            return 0
        if a.cmd == "messages":
            if a.sub == "send":
                if not a.target:
                    return emit({"ok": False, "error": "usage", "message": "messages send MESSAGE_ID"}, 2, as_json)
                res = rpc("msgs.send", id=a.target, source="wabctl")
            else:
                if not a.contact:
                    return emit({"ok": False, "error": "usage", "message": "messages find needs --contact NAME"}, 2, as_json)
                res = t_find({"contact": a.contact, "kind": a.kind, "from": a.sender, "query": a.query, "limit": a.limit, "hours": a.hours, "deliver_newest": bool(a.send)})
            return emit(res, code_for(res), as_json)
        if a.cmd == "watch":
            if a.sub == "list":
                res = rpc("watch.list")
            elif a.sub == "cancel":
                if not a.target:
                    return emit({"ok": False, "error": "usage", "message": "watch cancel ID|NAME|all"}, 2, as_json)
                res = rpc("watch.cancel", id=a.target)
            else:
                if not a.contact or not a.kind:
                    return emit({"ok": False, "error": "usage", "message": "watch add needs --contact NAME and --kind status|message"}, 2, as_json)
                res = t_watch({"contact": a.contact, "kind": a.kind, "condition": a.condition, "keep_watching": bool(a.keep), "hours": a.hours})
            return emit(res, code_for(res), as_json)
        if a.cmd == "tools":
            d = gemini_decls()
            print(json.dumps(d if a.plain else {"functionDeclarations": d}, indent=2))
            return 0
        if a.cmd == "prompt":
            print(PROMPT)
            return 0
        if a.cmd == "call":
            raw = sys.stdin.read() if a.args == "-" else a.args
            try:
                args = json.loads(raw or "{}")
            except json.JSONDecodeError as e:
                return emit({"ok": False, "error": "bad_args", "message": f"Arguments are not valid JSON: {e}"}, 2, True)
            res, code = call_tool(a.tool, args)
            return emit(res, code, True)
        if a.cmd in ("send", "draft"):
            text = text_arg(a)
            if a.cmd == "send":
                res = rpc("send", to=a.to, text=text, source="wabctl", **({"ttl": a.ttl} if a.ttl else {}))
                if res.get("ok") and a.wait and res.get("status") == "pending":
                    res = wait_for(res["id"], a.wait)
            else:
                res = rpc("draft", to=a.to, text=text, source="wabctl")
            return emit(res, code_for(res), as_json)
        if a.cmd == "notify":
            res = rpc("notify", text=a.text); return emit(res, code_for(res), as_json)
        if a.cmd == "check":
            res = rpc("get", id=a.id); return emit(res, code_for(res) if not res.get("ok") else 0, as_json)
        if a.cmd == "wait":
            res = wait_for(a.id, a.timeout)
            return emit(res, 124 if res.get("waiting") else code_for(res), as_json)
        if a.cmd == "cancel":
            res = rpc("cancel", id=a.id); return emit(res, code_for(res) if not res.get("ok") else 0, as_json)
        if a.cmd == "pending":
            res = rpc("list"); return emit(res, 0, as_json)
        if a.cmd == "bot":
            res = rpc("status"); return emit(res, code_for(res), as_json)
        if a.cmd == "contacts":
            res, code = contacts_cmd(a); return emit(res, code, as_json)
        if a.cmd == "log":
            lines = AUDIT.read_text().splitlines()[-a.tail:] if AUDIT.exists() else []
            for l in lines:
                print(l if as_json else " ".join(f"{k}={v}" for k, v in json.loads(l).items() if v is not None))
            return 0
        if a.cmd == "doctor":
            return doctor(as_json)
    except Unreachable as e:
        return emit({"ok": False, "error": "bot_unreachable", "message": str(e), "retryable": True}, 3, as_json)
    except (json.JSONDecodeError, OSError) as e:
        return emit({"ok": False, "error": "io", "message": str(e)}, 4, as_json)
    return 2


def doctor(as_json):
    checks = []
    def add(name, ok, detail=""): checks.append({"check": name, "ok": ok, "detail": detail})
    add("data dir", DATA.is_dir(), str(DATA))
    add("control socket", SOCK.exists(), str(SOCK))
    try:
        r = rpc("status", timeout=8)
        add("bot reachable", bool(r.get("ok")))
        add("whatsapp connected", r.get("connection") == "open", str(r.get("connection")))
        add("agent not paused", not r.get("paused"), f"pending={r.get('pending')}")
    except Unreachable as e:
        add("bot reachable", False, str(e))
    try:
        data = read_contacts()
        n = len(entries(data))
        add("contacts.json", True, f"{n} contact(s)" if n else "empty: add people with `wabctl contacts add NAME NUMBER`")
    except Exception as e:
        add("contacts.json", False, str(e))
    if as_json:
        print(json.dumps({"ok": all(c["ok"] for c in checks), "checks": checks}))
    else:
        for c in checks:
            print(f"[{'ok' if c['ok'] else 'FAIL'}] {c['check']}" + (f" - {c['detail']}" if c["detail"] else ""))
    return 0 if all(c["ok"] for c in checks) else 4


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
